<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FootballCards</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/game.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/gameEnd.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/gameLobby.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/card/bottomCardArea.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/card/card.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/gameArena/gameArena.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/gameArena/middleArea.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/gameArena/myArea.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/gameArena/opponentArea.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/gameArena/tiebreak.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/gameOver.css" asp-append-version="true" />
    <!--<link rel="stylesheet" href="~/FootballCards.styles.css" asp-append-version="true" />  -->
</head>
<body>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
